# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Web3 Configuration
VITE_WEB3_RPC=https://eth-mainnet.g.alchemy.com/v2/your-api-key
VITE_ETHERSCAN_API_KEY=your-etherscan-api-key

# AI Model Configuration
VITE_FACE_API_MODEL_URL=/models
VITE_DEEPFAKE_API_ENDPOINT=https://api.deepfake-detection.com
VITE_VOICE_ANALYSIS_ENDPOINT=https://api.voice-analysis.com

# Application Configuration
VITE_APP_NAME=DigiGuard
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:3000/api

# Feature Flags
VITE_ENABLE_BIOMETRIC=true
VITE_ENABLE_WEB3=true
VITE_ENABLE_DEEPFAKE_DETECTION=true
VITE_ENABLE_VOICE_ANALYSIS=true

# Analytics
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Optional: Third-party Services
VITE_STRIPE_PUBLIC_KEY=
VITE_GITHUB_TOKEN=
